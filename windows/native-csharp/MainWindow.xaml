<Window x:Class="CCP.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CCP.Windows.Models"
        xmlns:ui="clr-namespace:CCP.Windows.Ui"
        Title="CCP — Cross-Device Connectivity"
        Width="1320" Height="820" MinWidth="1080" MinHeight="680"
        Background="{StaticResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>

        <!-- ── Value converters ── -->
        <ui:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <ui:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
        <ui:CountToVisibilityConverter x:Key="ZeroIsHidden" Threshold="0"/>
        <ui:CountToVisibilityConverter x:Key="ZeroIsVisible" Threshold="-1"/>
        <ui:StateToBrushConverter x:Key="StateBrush"
                                  Disconnected="{StaticResource Surface3Brush}"
                                  Connecting="{StaticResource WarnSoft}"
                                  Connected="{StaticResource InfoSoft}"
                                  Ready="{StaticResource SuccessSoft}"
                                  Error="{StaticResource DangerSoft}"/>
        <ui:StateToBrushConverter x:Key="StateDot"
                                  Disconnected="{StaticResource TextMuted}"
                                  Connecting="{StaticResource WarnBrush}"
                                  Connected="{StaticResource InfoBrush}"
                                  Ready="{StaticResource SuccessBrush}"
                                  Error="{StaticResource DangerBrush}"/>
        <ui:StateToLabelConverter x:Key="StateLabel"
                                  Disconnected="Offline"
                                  Connecting="Connecting"
                                  Connected="Connected"
                                  Ready="Relay ready"
                                  Error="Error"/>

        <!-- ── Per-peer avatar brush (subtle color per platform) ── -->
        <DataTemplate x:Key="PeerAvatar" DataType="{x:Type models:PeerView}">
            <Grid Width="36" Height="36">
                <Border CornerRadius="{StaticResource R8}" Background="{StaticResource Surface4Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                    <TextBlock Text="{Binding PlatformInitial}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- Cloud / online indicator dot -->
                <Border Width="10" Height="10" CornerRadius="{StaticResource R999}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                        BorderThickness="2" BorderBrush="{StaticResource Surface1Brush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource TextMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCloudPeer}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCloudPeer}" Value="True"/>
                                        <Condition Binding="{Binding CloudOnline}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCloudPeer}" Value="True"/>
                                        <Condition Binding="{Binding CloudOnline}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ── Per-peer trust badge (tiny pill: Trusted / New / Cloud) ── -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource R999}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ── Peer row card ── -->
        <DataTemplate DataType="{x:Type models:PeerView}">
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                    CornerRadius="{StaticResource R10}" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PeerAvatar}" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DeviceName}" FontSize="{StaticResource FsBodyLg}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="160" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0" CornerRadius="{StaticResource R999}" Padding="6,2" VerticalAlignment="Center" BorderThickness="1"
                                    Background="{StaticResource SuccessSoft}" BorderBrush="{StaticResource SuccessBrush}">
                                <TextBlock Text="Trusted" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Trusted}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding EndpointLabel}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource TextMuted}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Content="Pair" Command="{Binding DataContext.PairCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0">
                            <Button.Visibility>
                                <Binding Path="Trusted" Converter="{StaticResource InvertBoolToVis}"/>
                            </Button.Visibility>
                        </Button>
                        <Button Content="Inspect" Command="{Binding DataContext.InspectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0">
                            <Button.Visibility>
                                <Binding Path="Trusted" Converter="{StaticResource BoolToVis}"/>
                            </Button.Visibility>
                        </Button>
                        <Button Content="Send" Command="{Binding DataContext.SendFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" Style="{StaticResource PrimaryBtn}">
                            <Button.Visibility>
                                <Binding Path="Trusted" Converter="{StaticResource BoolToVis}"/>
                            </Button.Visibility>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Empty state for any list ── -->
        <Style x:Key="EmptyState" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- ════════════════════════════════════════════════════════════════════════
         ROOT LAYOUT
         ════════════════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: App bar -->
            <RowDefinition Height="*"/>      <!-- 1: Body (rail + main) -->
            <RowDefinition Height="Auto"/>   <!-- 2: Footer -->
        </Grid.RowDefinitions>

        <!-- ════════════════  APP BAR  ════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid Height="54">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- brand -->
                    <ColumnDefinition Width="*"/>      <!-- selected peer chip -->
                    <ColumnDefinition Width="Auto"/>   <!-- local status -->
                    <ColumnDefinition Width="Auto"/>   <!-- cloud status -->
                    <ColumnDefinition Width="Auto"/>   <!-- actions -->
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="{StaticResource R6}" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="C" FontSize="14" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CCP" FontSize="{StaticResource FsTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border CornerRadius="{StaticResource R999}" Background="{StaticResource Surface3Brush}" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v0.2" FontSize="{StaticResource FsCaption}" FontWeight="Medium" Foreground="{StaticResource TextMuted}"/>
                    </Border>
                </StackPanel>

                <!-- Selected peer chip -->
                <Border Grid.Column="1" CornerRadius="{StaticResource R999}" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                        Padding="12,6" Margin="20,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="380">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPeerSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SelectedPeerLabel}" FontSize="{StaticResource FsBody}" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                    </StackPanel>
                </Border>

                <!-- Local status pill -->
                <Border Grid.Column="2" Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Bridge online" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <!-- Cloud status pill (driven by enum, not fragile string match) -->
                <Border Grid.Column="3" CornerRadius="{StaticResource R999}" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{Binding CloudState, Converter={StaticResource StateBrush}}"
                        BorderBrush="{Binding CloudState, Converter={StaticResource StateDot}}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{Binding CloudState, Converter={StaticResource StateDot}}"/>
                        <TextBlock Text="{Binding CloudState, Converter={StaticResource StateLabel}}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <!-- Toolbar actions -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource IconBtn}" ToolTip="Resend discovery broadcast">
                        <TextBlock Text="⟳" FontSize="16" Foreground="{StaticResource TextSecondary}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════  BODY (rail + main)  ════════════════ -->
        <Grid Grid.Row="1" Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT RAIL ──────────────────────────────────────────────────── -->
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource R12}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- header -->
                        <RowDefinition Height="*"/>      <!-- list -->
                    </Grid.RowDefinitions>

                    <!-- Rail header -->
                    <StackPanel Margin="16,16,16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Devices" FontSize="{StaticResource FsSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Visible on this network &amp; cloud" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding IsCloudModeEnabled, Mode=OneWay}" Command="{Binding ToggleCloudCommand}"
                                          Cursor="Hand" ToolTip="Toggle Long Distance (cloud relay)">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="{StaticResource R999}" Padding="8,4"
                                                Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="☁" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Lbl" Text="Cloud" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface4Brush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InfoSoft}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                                                <Setter TargetName="Lbl" Property="Text" Value="Cloud · On"/>
                                                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                    </StackPanel>

                    <!-- Peer list -->
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Peers}" SelectedItem="{Binding SelectedPeer}"
                                 SelectedValue="{Binding SelectedPeerId, Mode=TwoWay}" SelectedValuePath="DeviceId"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Padding="12,0,12,12">
                            <ListBox.Resources>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"/>
                            </ListBox.Resources>
                        </ListBox>

                        <!-- Empty state: no peers yet -->
                        <StackPanel Style="{StaticResource EmptyState}" Margin="24"
                                    Visibility="{Binding Peers.Count, Converter={StaticResource ZeroIsHidden}}">
                            <Border Width="56" Height="56" CornerRadius="{StaticResource R999}" Background="{StaticResource Surface3Brush}" Margin="0,0,0,12">
                                <TextBlock Text="◎" FontSize="22" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Looking for devices…" FontSize="{StaticResource FsBodyLg}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Make sure your phone is on the same Wi-Fi and CCP is open." FontSize="{StaticResource FsCaption}" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap" MaxWidth="240" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── MAIN PANEL ─────────────────────────────────────────────────── -->
            <Border Grid.Column="1" Margin="16,0,0,0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource R12}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- title block -->
                        <RowDefinition Height="Auto"/>   <!-- stats row -->
                        <RowDefinition Height="Auto"/>   <!-- action toolbar -->
                        <RowDefinition Height="*"/>      <!-- tab content -->
                    </Grid.RowDefinitions>

                    <!-- Title + reload -->
                    <Grid Margin="24,22,24,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding PanelTitle}" FontSize="{StaticResource FsDisplay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding PanelSubtitle}" FontSize="{StaticResource FsBody}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding RefreshPanelCommand}" Style="{StaticResource GhostBtn}" ToolTip="Reload this device's panel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⟳" FontSize="13" Margin="0,0,6,0" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="Reload" FontSize="{StaticResource FsBody}" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Stats hero row -->
                    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="24,0,24,16">
                        <UniformGrid.Resources>
                            <Style TargetType="Border" x:Key="StatCell">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="{StaticResource R10}"/>
                                <Setter Property="Padding" Value="16,14"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </Style>
                        </UniformGrid.Resources>
                        <Border Style="{StaticResource StatCell}">
                            <StackPanel>
                                <TextBlock Text="BATTERY" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding BatteryText}" FontSize="{StaticResource FsDisplay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCell}">
                            <StackPanel>
                                <TextBlock Text="STORAGE" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding StorageText}" FontSize="{StaticResource FsSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCell}">
                            <StackPanel>
                                <TextBlock Text="NOTIFICATIONS" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding NotificationAccessText}" FontSize="{StaticResource FsSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCell}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="GALLERY" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding GalleryAccessText}" FontSize="{StaticResource FsSubtitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Action toolbar (quick remote actions) -->
                    <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource R10}" Margin="24,0,24,16" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="QUICK ACTIONS" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"  Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding SelectedTransportOption}"/>
                                <TextBox Grid.Column="1" Text="{Binding DialNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="10,0" VerticalContentAlignment="Center" Padding="10,0" MinHeight="30"
                                         Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Foreground="{StaticResource TextPrimary}"/>
                                <Button Grid.Column="2" Content="Dial"     Command="{Binding DialCommand}"            Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                                <Button Grid.Column="3" Content="Answer"   Command="{Binding AnswerCallCommand}"     Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                                <Button Grid.Column="4" Content="Wi-Fi"    Command="{Binding OpenWifiSettingsCommand}"     Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                                <Button Grid.Column="5" Content="Bluetooth" Command="{Binding OpenBluetoothSettingsCommand}" Style="{StaticResource SecondaryBtn}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Location"      Command="{Binding OpenLocationSettingsCommand}"      Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                                <Button Content="Notifications" Command="{Binding OpenNotificationSettingsCommand}" Style="{StaticResource SecondaryBtn}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tab content -->
                    <TabControl Grid.Row="3" Style="{StaticResource UnderlineTabCtrl}" Margin="24,0,24,0">
                        <TabItem Header="Overview" Style="{StaticResource UnderlineTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DeviceSettings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RemoteFactView}">
                                            <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="{StaticResource FsBody}" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{StaticResource FsBody}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Gallery" Style="{StaticResource UnderlineTab}">
                            <Grid>
                                <ListBox ItemsSource="{Binding GalleryItems}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RemoteContentItem}">
                                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource R8}" Margin="0,0,0,8" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="44" Height="44" CornerRadius="{StaticResource R8}" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" VerticalAlignment="Center">
                                                        <TextBlock Text="🖼" FontSize="16" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsBodyLg}" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Style="{StaticResource EmptyState}" Margin="24"
                                            Visibility="{Binding GalleryItems.Count, Converter={StaticResource ZeroIsHidden}}">
                                    <TextBlock Text="🖼" FontSize="32" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No gallery items" FontSize="{StaticResource FsBodyLg}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Grant gallery access on the device to browse photos here." FontSize="{StaticResource FsCaption}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="260" TextAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Files" Style="{StaticResource UnderlineTab}">
                            <Grid>
                                <ListBox ItemsSource="{Binding FileItems}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RemoteContentItem}">
                                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource R8}" Margin="0,0,0,8" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="44" Height="44" CornerRadius="{StaticResource R8}" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" VerticalAlignment="Center">
                                                        <TextBlock Text="📄" FontSize="16" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsBodyLg}" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Style="{StaticResource EmptyState}" Margin="24"
                                            Visibility="{Binding FileItems.Count, Converter={StaticResource ZeroIsHidden}}">
                                    <TextBlock Text="📂" FontSize="32" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No shared files" FontSize="{StaticResource FsBodyLg}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Use the Send button on a trusted device to share a file." FontSize="{StaticResource FsCaption}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="260" TextAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Notifications" Style="{StaticResource UnderlineTab}">
                            <Grid>
                                <ListBox ItemsSource="{Binding NotificationItems}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RemoteContentItem}">
                                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource R8}" Margin="0,0,0,8" Padding="14,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsBodyLg}" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Style="{StaticResource EmptyState}" Margin="24"
                                            Visibility="{Binding NotificationItems.Count, Converter={StaticResource ZeroIsHidden}}">
                                    <TextBlock Text="🔔" FontSize="32" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No notifications" FontSize="{StaticResource FsBodyLg}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Enable notification access for CCP on the device to mirror them here." FontSize="{StaticResource FsCaption}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="280" TextAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Activity" Style="{StaticResource UnderlineTab}">
                            <ListBox ItemsSource="{Binding Events}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="{StaticResource R8}" Margin="0,0,0,6" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="{StaticResource FsBody}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════  FOOTER  ════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,8" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FooterStatus}" FontSize="{StaticResource FsCaption}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="ccp.v0  ·  UDP 47827  ·  TCP 47828" FontSize="{StaticResource FsCaption}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
