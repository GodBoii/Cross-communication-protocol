# Normalize line endings in the repository; check out with native endings.
* text=auto

# Windows-only scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix scripts must keep LF.
*.sh text eol=lf
gradlew text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.keystore binary
*.jks binary
